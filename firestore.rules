rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: Replace WRITE_TOKEN_HERE with the same long random token
    // you put on your NFC tags. Deploy these rules from Firebase Console
    // or the Firebase CLI. Do not commit your real token to a public repo
    // if your GitHub repo is public — keep a private copy of this file,
    // or deploy rules only from your machine.
    //
    // Generate a token (PowerShell):
    // -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })

    function isSignedIn() {
      return request.auth != null;
    }

    function validWriteToken() {
      return request.resource.data.token == 'WRITE_TOKEN_HERE';
    }

    function validMedication() {
      return request.resource.data.medication in ['latuda', 'lamotrigine'];
    }

    function validMedLog() {
      return request.resource.data.keys().hasAll(['medication', 'takenAt', 'token', 'dayKey'])
        && validMedication()
        && validWriteToken()
        && request.resource.data.takenAt is string
        && request.resource.data.dayKey is string
        && request.resource.data.medication is string;
    }

    match /medicationLogs/{logId} {
      // NFC scan: create only, with write token from the tag URL (no login)
      allow create: if validMedLog();
      // Dashboard: signed-in user can read / manage
      allow read, update, delete: if isSignedIn();
    }

    match /moodLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['moodScore', 'createdAt', 'dayKey'])
        && request.resource.data.moodScore is int
        && request.resource.data.moodScore >= 1
        && request.resource.data.moodScore <= 10;
      allow read, update, delete: if isSignedIn();
    }
  }
}
