rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace WRITE_TOKEN_HERE with the same token on all NFC tags.
    // Deploy these rules in Firebase Console → Firestore → Rules → Publish.
    //
    // Generate a token (PowerShell):
    // -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })

    function validWriteToken() {
      return request.resource.data.token == 'WRITE_TOKEN_HERE';
    }

    function validMedication() {
      return request.resource.data.medication in ['latuda', 'lamotrigine', 'pantoprazole'];
    }

    function validMedLog() {
      return request.resource.data.keys().hasAll(['medication', 'takenAt', 'token', 'dayKey'])
        && validMedication()
        && validWriteToken()
        && request.resource.data.takenAt is string
        && request.resource.data.dayKey is string
        && request.resource.data.medication is string;
    }

    function validMoodLog() {
      return request.resource.data.keys().hasAll(['moodScore', 'createdAtClient', 'dayKey', 'token'])
        && validWriteToken()
        && request.resource.data.moodScore is int
        && request.resource.data.moodScore >= 1
        && request.resource.data.moodScore <= 10
        && request.resource.data.createdAtClient is string
        && request.resource.data.dayKey is string;
    }

    match /medicationLogs/{logId} {
      // Writes require the NFC token. Reads are open so History works after a scan unlocks the phone UI.
      // Keep your site + Firebase project private; do not share the token.
      allow create: if validMedLog();
      allow read: if true;
      allow update, delete: if false;
    }

    match /moodLogs/{logId} {
      allow create: if validMoodLog();
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
